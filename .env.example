# Primary AI Provider Strategy: "auto" | "gemini" | "groq"
LLM_PROVIDER=auto

# 1. Google Gemini (Gemini 2.5 Flash with 1M context window)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq LPU (Ultra-fast LPUs with JSON Mode)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 3. Tavily AI Automated Web Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Public App URL (update to your production Vercel URL upon deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
